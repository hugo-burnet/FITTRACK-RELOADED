{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fittrack.example/schemas/exercise-v1.json",
  "title": "Exercise — fiche exercice FitTrack",
  "description": "Schéma dérivé de la section 10 du document Anatomie/biomécanique. Sépare anatomie, biomécanique, hypertrophie directe, EMG et expert_practice.",
  "type": "object",
  "required": ["id", "name", "movementPattern", "evidenceConfidence"],
  "properties": {
    "id": { "type": "string", "pattern": "^ex-[a-z0-9-]+$" },
    "name": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "movementPattern": {
      "enum": [
        "poussee_horizontale",
        "poussee_verticale",
        "tirage_horizontal",
        "tirage_vertical",
        "squat",
        "hinge",
        "fente",
        "isolation_coude",
        "isolation_epaule",
        "isolation_cheville",
        "isolation_genou",
        "isolation_hanche",
        "autre"
      ]
    },
    "jointActions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "primaryMuscles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["muscleId"],
        "properties": {
          "muscleId": { "type": "string" },
          "region": { "type": ["string", "null"] },
          "confidence": {
            "enum": ["high", "moderate", "low", "very_low", "moderate_to_high"]
          },
          "basis": {
            "enum": [
              "direct_hypertrophy_trial",
              "biomechanical",
              "imaging",
              "emg_only",
              "expert_practice",
              "anatomical"
            ]
          }
        }
      }
    },
    "secondaryMuscles": { "type": "array", "items": { "type": "string" } },
    "stabilizerMuscles": { "type": "array", "items": { "type": "string" } },
    "equipment": {
      "type": "array",
      "items": {
        "enum": [
          "barre",
          "halteres",
          "cable",
          "machine",
          "poids_du_corps",
          "kettlebell",
          "smith",
          "bande",
          "autre"
        ]
      }
    },
    "resistanceProfile": {
      "enum": ["ascendant", "descendant", "en_cloche", "constant_approximatif", "variable_selon_materiel", "inconnu"]
    },
    "lengthenedBias": { "type": ["boolean", "null"] },
    "stabilityDemand": {
      "enum": ["guide_machine", "poids_libre_stable", "poids_libre_instable", "inconnu"]
    },
    "axialLoad": { "type": ["boolean", "null"] },
    "lumbarDemand": {
      "enum": ["none", "low", "moderate", "high", "inconnu"]
    },
    "romUtile": { "type": ["string", "null"] },
    "progressionPotential": {
      "type": "string",
      "description": "Toujours étiqueté expert_practice"
    },
    "jointConstraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["joint", "constraintType"],
        "properties": {
          "joint": { "type": "string" },
          "constraintType": {
            "enum": [
              "charge_mecanique",
              "inconfort_rapporte",
              "risque_demontre",
              "risque_suppose"
            ]
          },
          "source": { "type": ["string", "null"] }
        }
      }
    },
    "substitutionGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["exerciseId", "equivalenceLevel"],
        "properties": {
          "exerciseId": { "type": "string" },
          "equivalenceLevel": {
            "enum": ["quasiDirecte", "acceptable", "partielle"]
          },
          "differingDimensions": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "evidenceConfidence": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Objet par affirmation, jamais un score global unique"
    },
    "practicalNotes": {
      "type": ["string", "null"],
      "description": "Toujours marqué expert_practice"
    },
    "corpusFragments": {
      "type": "array",
      "items": { "type": "string" }
    },
    "validationStatus": {
      "enum": ["pending_human_review", "approved", "rejected", "needs_revision"]
    }
  },
  "additionalProperties": false
}

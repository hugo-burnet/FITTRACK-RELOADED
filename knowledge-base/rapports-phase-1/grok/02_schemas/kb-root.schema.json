{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fittrack.example/schemas/kb-root-v1.json",
  "title": "Knowledge Base FitTrack — racine",
  "description": "Schéma racine de la KB unifiée. Versionnée et auditable.",
  "type": "object",
  "required": ["kbVersion", "created", "lastEvidenceReview", "domains"],
  "properties": {
    "kbVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic versioning MAJOR.MINOR.PATCH"
    },
    "created": { "type": "string", "format": "date-time" },
    "lastEvidenceReview": { "type": "string", "format": "date" },
    "corpusFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["filename", "sha256"],
        "properties": {
          "filename": { "type": "string" },
          "sha256": { "type": "string" },
          "lastModified": { "type": "string", "format": "date-time" }
        }
      }
    },
    "domains": {
      "type": "object",
      "properties": {
        "programming": { "type": "object" },
        "biomechanics": { "type": "object" },
        "exerciseSelection": { "type": "object" },
        "clinicalSafety": { "type": "object" }
      }
    },
    "entityCounts": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "date", "summary"],
        "properties": {
          "version": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "summary": { "type": "string" },
          "breakingChanges": { "type": "boolean" }
        }
      }
    }
  },
  "additionalProperties": false
}
